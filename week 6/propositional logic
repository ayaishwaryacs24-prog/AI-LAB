
#include <stdio.h>

int main() {
    int p, q;

    printf("Enter P (0 or 1): ");
    scanf("%d", &p);

    printf("Enter Q (0 or 1): ");
    scanf("%d", &q);

    printf("\nAND = %d", p && q);
    printf("\nOR = %d", p || q);
    printf("\nNOT P = %d", !p);
    printf("\nP IMPLIES Q = %d", !p || q);

    return 0;
}
